      "transcript": [
        {
          "timestamp": 1769282637.232411,
          "speaker": "agent",
          "text": "Hello?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282640.048417,
          "speaker": "agent",
          "text": "This is Far East Chinese Restaurant. How can I help you today?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282641.284321,
          "speaker": "customer",
          "text": "Hi, yes, I'd like to place an order. Um, let me get the... orange chicken? The combination plate.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282659.4178078,
          "speaker": "agent",
          "text": "Sure, we'll start with the orange chicken combination plate. Would you like to keep the pork fried rice and egg roll, or would you like to make any substitutions?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282659.933158,
          "speaker": "customer",
          "text": "Actually, wait, make that General Tso's instead. And, uh, yeah, pork fried rice and an egg roll is fine.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282676.6084638,
          "speaker": "agent",
          "text": "Got it. We'll switch that to the General Tso's Chicken combination plate with pork fried rice and an egg roll.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282678.895654,
          "speaker": "agent",
          "text": "What else would you like to order?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282679.6157959,
          "speaker": "customer",
          "text": "Hmm, does the General Tso's have a lot of sauce? Maybe I'll do Sesame Chicken instead. Oh, I'm sorry, can I change that?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282695.868356,
          "speaker": "agent",
          "text": "No problem at all. We can change that to the sesame chicken combination plate. We'll keep the pork fried rice and egg roll as is.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282698.232364,
          "speaker": "agent",
          "text": "Anything else for your order?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282698.905986,
          "speaker": "customer",
          "text": "Wait, what's the difference between sesame chicken and orange chicken? I'm having a hard time deciding.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282712.220983,
          "speaker": "agent",
          "text": "Sure, let me clarify.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282716.16538,
          "speaker": "agent",
          "text": "Sesame chicken usually has a sweet, savory glaze with sesame seeds on top.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282723.5250182,
          "speaker": "agent",
          "text": "while orange chicken has a tangy, citrusy sauce with a hint of orange flavor. Both are crispy and delicious.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282726.7251232,
          "speaker": "agent",
          "text": "Let me know which one you'd prefer for your combination plate.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282729.431843,
          "speaker": "customer",
          "text": "You know what, let's just do the General Tso's combination. Sorry, I'm being difficult, aren't I? Okay, okay, final decision.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282747.28645,
          "speaker": "agent",
          "text": "No worries at all. You're not being difficult.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282752.450144,
          "speaker": "agent",
          "text": "So we've got the general toast chicken combination plate with pork fried rice and an egg roll.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282753.398548,
          "speaker": "agent",
          "text": "Anything else for your order today?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282756.701897,
          "speaker": "customer",
          "text": "Yes, I'll have an egg roll. Actually, make that two egg rolls. Oh, wait, do you have spring rolls? Let me do spring rolls instead. Actually no, just the two egg rolls is fine. Sorry about that.",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282777.981958,
          "speaker": "agent",
          "text": "Got it. We'll add two roast pork egg rolls to your order. No problem at all. Is there anything else you'd like to add?",
          "audio_duration_ms": null
        },
        {
          "timestamp": 1769282778.996834,
          "speaker": "customer",
          "text": "No, that's all I need. Thank you!",
          "audio_duration_ms": null
        }
      ],
